<Window
    x:Class="MonitorDial.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarArea" Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image x:Name="TitleIcon" Width="16" Height="16" />
                <TextBlock Text="MonitorDial" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="20,4,16,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="MonitorName" Text="Procurando monitor..." Style="{ThemeResource SubtitleTextBlockStyle}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="MonitorInfo" Text="" Opacity="0.7" TextWrapping="Wrap"
                           Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>
            <Button x:Name="ReloadButton" Grid.Column="1" VerticalAlignment="Center" Padding="8"
                    AutomationProperties.AutomationId="reload" AutomationProperties.Name="Recarregar"
                    ToolTipService.ToolTip="Recarregar" Click="OnReloadClick">
                <FontIcon Glyph="&#xE72C;" FontSize="16" />
            </Button>
            <ToggleButton x:Name="SettingsButton" Grid.Column="2" VerticalAlignment="Center" Padding="8"
                          AutomationProperties.AutomationId="settings" AutomationProperties.Name="Configurações"
                          ToolTipService.ToolTip="Configurações" Click="OnSettingsClick">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </ToggleButton>
        </Grid>

        <ScrollViewer x:Name="ControlsView" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Root" Margin="20,0,20,20" Spacing="12" />
        </ScrollViewer>

        <ScrollViewer x:Name="SettingsView" Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="20,0,20,20" Spacing="12">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Geral" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <ToggleSwitch x:Name="StartupToggle" Header="Iniciar com o Windows"
                                      OnContent="Ligado" OffContent="Desligado"
                                      AutomationProperties.AutomationId="startupToggle" Toggled="OnStartupToggled" />
                        <ComboBox x:Name="CornerBox" Header="Canto da tela onde o painel abre" HorizontalAlignment="Stretch"
                                  AutomationProperties.AutomationId="cornerBox" SelectionChanged="OnCornerChanged">
                            <ComboBoxItem Content="Inferior direito" Tag="BottomRight" />
                            <ComboBoxItem Content="Inferior esquerdo" Tag="BottomLeft" />
                            <ComboBoxItem Content="Superior direito" Tag="TopRight" />
                            <ComboBoxItem Content="Superior esquerdo" Tag="TopLeft" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Atualizações" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <ToggleSwitch x:Name="AutoUpdateToggle" Header="Procurar atualizações automaticamente"
                                      OnContent="Ligado" OffContent="Desligado"
                                      AutomationProperties.AutomationId="autoUpdateToggle" Toggled="OnAutoUpdateToggled" />
                        <TextBlock x:Name="VersionText" AutomationProperties.AutomationId="versionText" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CheckUpdateButton" Content="Procurar atualizações"
                                    AutomationProperties.AutomationId="checkUpdate" Click="OnCheckUpdateClick" />
                            <Button x:Name="InstallUpdateButton" Content="Instalar e reiniciar" Visibility="Collapsed"
                                    Style="{ThemeResource AccentButtonStyle}" Click="OnInstallUpdateClick" />
                        </StackPanel>
                        <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Opacity="0.7"
                                   AutomationProperties.AutomationId="updateStatus" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Sobre" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.7"
                                   Text="Controla os ajustes do monitor pelo cabo de vídeo (DDC/CI), usando a API nativa do Windows." />
                        <HyperlinkButton Content="github.com/trupper9/MonitorDial" Padding="0"
                                         NavigateUri="https://github.com/trupper9/MonitorDial" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <InfoBar x:Name="Status" Grid.Row="3" IsOpen="False" IsClosable="True" Margin="20,0,20,12" />
    </Grid>
</Window>
