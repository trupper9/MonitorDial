<Application
    x:Class="MonitorDial.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <!--
                    As listas suspensas e menus usam acrílico por padrão, e nesta janela ele
                    sai transparente: o texto de trás vaza. Este dicionário vem depois do
                    XamlControlsResources para ter precedência e troca o fundo por um sólido.
                -->
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FF2C2C2C" />
                            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FF2C2C2C" />
                            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FF2C2C2C" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFF9F9F9" />
                            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FFF9F9F9" />
                            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFF9F9F9" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
